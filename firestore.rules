rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Identity is Clerk, not Firebase Auth, so request.auth is unused.
    // Booking and profile docs store Clerk user ids in `userId` / document id.
    match /users/{userId} {
      allow read, write: if true;
    }

    match /slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
